# AI Internship Application Agent Configuration (.env.example)
# Copy this file to .env and fill in your credentials. Never commit .env to version control.

# -----------------------------------------------------------------------------
# 1. LLM Provider Configuration ("none", "gemini", "openai", "groq")
# -----------------------------------------------------------------------------
AI_PROVIDER=none
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
AI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# 2. Embeddings Configuration
# -----------------------------------------------------------------------------
USE_SENTENCE_TRANSFORMERS=false
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# 3. Database & Logging Paths
# -----------------------------------------------------------------------------
DATABASE_PATH=data/internship_agent.db
LOG_FILE_PATH=logs/agent.log
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 4. Discovery Preferences
# -----------------------------------------------------------------------------
DEFAULT_ROLES=AI Engineer,Agentic AI Developer,Generative AI Engineer,Machine Learning Engineer,Data Scientist,LLM Engineer,Python Developer
DEFAULT_LOCATIONS=Remote,India,Bangalore,Hyderabad,Pune,Delhi NCR
DAILY_DISCOVERY_LIMIT=50

# -----------------------------------------------------------------------------
# 5. Browser Automation Security & Permissions
# -----------------------------------------------------------------------------
BROWSER_HEADLESS=false
BROWSER_TIMEOUT_MS=15000
REQUIRE_HUMAN_APPROVAL=true
PAUSE_ON_CAPTCHA=true
PAUSE_ON_AUTH=true
ALLOWED_DOMAINS=localhost,127.0.0.1,internshala.com,wellfound.com,naukri.com,greenhouse.io,lever.co,workday.com

# -----------------------------------------------------------------------------
# 6. Email Notification System (Gmail SMTP App Password or OAuth2)
# -----------------------------------------------------------------------------
EMAIL_NOTIFICATIONS_ENABLED=true
RECIPIENT_EMAIL=your_recipient_email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
EMAIL_AUTH_METHOD=app_password
SMTP_SENDER_EMAIL=your_sender_email@gmail.com
SMTP_APP_PASSWORD=your_16_char_gmail_app_password_here
SMTP_OAUTH_ACCESS_TOKEN=your_optional_oauth2_bearer_token_here

# Notification Event Toggles
NOTIFY_ON_SUBMISSION_SUCCESS=true
NOTIFY_ON_SUBMISSION_FAILURE=true
NOTIFY_ON_AWAITING_APPROVAL=true
NOTIFY_ON_HIGH_MATCH=true
NOTIFY_ON_INTERVIEW_STATUS=true
